# Runtime mode
NODE_ENV=production

# Render provides PORT automatically. Keep this for local testing.
PORT=3000

# CORS allowlist. Comma-separated origins.
# Example: ALLOWED_ORIGINS=https://your-app.onrender.com,https://www.yourdomain.com
# When unset, the relay is fail-closed: it allows SAME-ORIGIN requests only (which
# covers the self-host single-container case) and blocks cross-origin. Set this to
# permit specific external origins. A bare `*` opts back into allow-all.
ALLOWED_ORIGINS=

# Request/relay hardening
BODY_SIZE_LIMIT=1mb
REQUEST_TIMEOUT_MS=120000
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=20
OLLAMA_TEST_TIMEOUT_MS=5000

# Per-auditor request ceiling (server-side backstop to client-side conversation /
# time limits, MOD-7). Max chat requests per pid within the rolling window.
MAX_CHAT_REQUESTS_PER_SESSION=300
SESSION_RATE_WINDOW_MS=3600000

# Security toggle for Ollama endpoint validation.
# false = block private/local network addresses to reduce SSRF risk.
# true  = allow private/local endpoints (for trusted/internal deployments only).
ALLOW_PRIVATE_OLLAMA_URLS=false

# Same toggle for cloud/vLLM `baseUrl` endpoints on the api backend.
# Keep false in production; set true only if your vLLM runs on a private address.
ALLOW_PRIVATE_API_URLS=false

# --- Provider API keys (server-side only — MOD-1) ----------------------------
# Set the key(s) for the provider(s) your studies use. Keys live ONLY here in
# the relay environment: they are never stored in study configs, the database,
# or sent to any browser.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
VLLM_API_KEY=

# Allow a client-supplied per-request key as a FALLBACK when no server key is
# set (the BYO-key mode reserved for a public hosted demo). Keep false for
# self-hosted research deployments.
ALLOW_CLIENT_API_KEYS=false
