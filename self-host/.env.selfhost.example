# Copy to self-host/.env and fill in. Used by docker-compose.trails.yml.

# --- Supabase (from your self-hosted stack) ---------------------------------
# The browser-reachable URL of the Supabase API gateway (Kong). For local dev
# this is the host's :8000. In production use your real domain/https.
REACT_APP_SUPABASE_URL=http://localhost:8000
# The ANON_KEY value from your Supabase docker/.env (NOT the service_role key).
REACT_APP_SUPABASE_ANON_KEY=replace-with-your-anon-key

# --- Relay (server.js) ------------------------------------------------------
# Comma-separated allowlist of origins permitted to call the relay.
# Use your app's public origin in production; "*" is fine for local testing.
ALLOWED_ORIGINS=*
# Block private/local Ollama URLs (SSRF protection). Keep false unless you trust
# the network and want to allow a local Ollama.
ALLOW_PRIVATE_OLLAMA_URLS=false
# Same protection for cloud/vLLM baseUrl endpoints; true only for LAN vLLM.
ALLOW_PRIVATE_API_URLS=false

# --- Provider API keys (server-side only — never in study configs) ----------
# Set the key(s) for the provider(s) your studies will use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
VLLM_API_KEY=
